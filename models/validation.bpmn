      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_P1" bpmnElement="P1">
        <di:waypoint x="126" y="168" />
        <di:waypoint x="180" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P2" bpmnElement="P2">
        <di:waypoint x="330" y="168" />
        <di:waypoint x="390" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P3" bpmnElement="P3">
        <di:waypoint x="540" y="168" />
        <di:waypoint x="600" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P4" bpmnElement="P4">
        <di:waypoint x="650" y="168" />
        <di:waypoint x="700" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P5" bpmnElement="P5">
        <di:waypoint x="725" y="143" />
        <di:waypoint x="725" y="108" />
        <di:waypoint x="940" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P6" bpmnElement="P6">
        <di:waypoint x="976" y="108" />
        <di:waypoint x="1160" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P7" bpmnElement="P7">
        <di:waypoint x="725" y="193" />
        <di:waypoint x="725" y="263" />
        <di:waypoint x="810" y="263" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P8" bpmnElement="P8">
        <di:waypoint x="846" y="263" />
        <di:waypoint x="940" y="263" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P9" bpmnElement="P9">
        <di:waypoint x="1090" y="263" />
        <di:waypoint x="1150" y="263" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P10" bpmnElement="P10">
        <di:waypoint x="1225" y="303" />
        <di:waypoint x="1225" y="330" />
        <di:waypoint x="625" y="330" />
        <di:waypoint x="625" y="193" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F1" bpmnElement="F1">
        <di:waypoint x="126" y="608" />
        <di:waypoint x="195" y="608" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F2" bpmnElement="F2">
        <di:waypoint x="245" y="608" />
        <di:waypoint x="290" y="608" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F3" bpmnElement="F3">
        <di:waypoint x="440" y="608" />
        <di:waypoint x="500" y="608" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Valid" bpmnElement="F_Valid">
        <di:waypoint x="550" y="608" />
        <di:waypoint x="700" y="608" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="595" y="580" width="50" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Invalid" bpmnElement="F_Invalid">
        <di:waypoint x="525" y="633" />
        <di:waypoint x="525" y="788" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="700" width="50" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F4" bpmnElement="F4">
        <di:waypoint x="450" y="828" />
        <di:waypoint x="326" y="828" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F5" bpmnElement="F5">
        <di:waypoint x="290" y="828" />
        <di:waypoint x="220" y="828" />
        <di:waypoint x="220" y="633" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Organic" bpmnElement="F_Organic">
        <di:waypoint x="750" y="608" />
        <di:waypoint x="850" y="608" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="775" y="580" width="50" height="20" />
        </bpmndi:BPMNLabel>
