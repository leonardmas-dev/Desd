      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_Published" bpmnElement="Catch_Published">
        <dc:Bounds x="940" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="905" y="133" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ProducerPublished" bpmnElement="End_ProducerPublished">
        <dc:Bounds x="1160" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="130" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_Correction" bpmnElement="Catch_Correction">
        <dc:Bounds x="810" y="245" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="775" y="288" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CorrectDetails" bpmnElement="Task_CorrectDetails">
        <dc:Bounds x="940" y="223" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendCorrections" bpmnElement="Task_SendCorrections">
        <dc:Bounds x="1150" y="223" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_ProductSubmitted" bpmnElement="Start_ProductSubmitted">
        <dc:Bounds x="90" y="590" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="55" y="633" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ValidationMerge" bpmnElement="Gateway_ValidationMerge">
        <dc:Bounds x="195" y="583" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateDetails" bpmnElement="Task_ValidateDetails">
        <dc:Bounds x="290" y="568" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_DetailsValid" bpmnElement="Gateway_DetailsValid">
        <dc:Bounds x="500" y="583" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="470" y="540" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OrganicClaim" bpmnElement="Gateway_OrganicClaim">
        <dc:Bounds x="700" y="583" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="640" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_VerifyCertification" bpmnElement="Task_VerifyCertification">
        <dc:Bounds x="850" y="568" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_PublicationJoin" bpmnElement="Gateway_PublicationJoin">
        <dc:Bounds x="1070" y="583" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PublishProduct" bpmnElement="Task_PublishProduct">
        <dc:Bounds x="1180" y="568" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_NotifyPublished" bpmnElement="Task_NotifyPublished">
