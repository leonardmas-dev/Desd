        <dc:Bounds x="600" y="143" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_WaitOutcome" bpmnElement="Gateway_WaitOutcome">
        <dc:Bounds x="700" y="143" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="195" width="120" height="30" />
