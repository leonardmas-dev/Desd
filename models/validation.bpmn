<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_UC1_Validation" targetNamespace="https://brfn.example/uc1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_Submitted" name="brfn.product.submitted" />
  <bpmn:message id="Msg_Correction" name="brfn.product.correction-requested" />
  <bpmn:message id="Msg_Corrected" name="brfn.product.corrected">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= submissionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Published" name="brfn.product.published" />
  <bpmn:collaboration id="Collaboration_ProductValidation">
    <bpmn:participant id="Pool_Producer" name="Registered Producer" processRef="Process_ProducerSubmission" />
    <bpmn:participant id="Pool_Marketplace" name="Marketplace System" processRef="Process_ProductValidation" />
    <bpmn:messageFlow id="M_Submit" sourceRef="Task_SendSubmission" targetRef="Start_ProductSubmitted" name="Product submission" />
    <bpmn:messageFlow id="M_Correct" sourceRef="Task_SendCorrections" targetRef="Catch_CorrectedDetails" name="Corrected product data" />
    <bpmn:messageFlow id="M_Feedback" sourceRef="Task_RequestCorrection" targetRef="Catch_Correction" name="Validation feedback" />
    <bpmn:messageFlow id="M_Published" sourceRef="Task_NotifyPublished" targetRef="Catch_Published" name="Publication confirmed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProducerSubmission" name="Producer submission and corrections" isExecutable="false">
    <bpmn:startEvent id="Start_Producer" name="List a product">
      <bpmn:outgoing>P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitDetails" name="Submit product details">
      <bpmn:incoming>P1</bpmn:incoming>
      <bpmn:outgoing>P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendSubmission" name="Send product submission">
      <bpmn:incoming>P2</bpmn:incoming>
      <bpmn:outgoing>P3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_ProducerMerge" name="">
      <bpmn:incoming>P3</bpmn:incoming>
      <bpmn:outgoing>P4</bpmn:outgoing>
      <bpmn:incoming>P10</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_WaitOutcome" name="Wait for response">
      <bpmn:incoming>P4</bpmn:incoming>
      <bpmn:outgoing>P5</bpmn:outgoing>
      <bpmn:outgoing>P7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Published" name="Publication confirmed">
      <bpmn:messageEventDefinition messageRef="Msg_Published" />
      <bpmn:incoming>P5</bpmn:incoming>
      <bpmn:outgoing>P6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_ProducerPublished" name="Product listed">
      <bpmn:incoming>P6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_Correction" name="Correction requested">
      <bpmn:messageEventDefinition messageRef="Msg_Correction" />
      <bpmn:incoming>P7</bpmn:incoming>
      <bpmn:outgoing>P8</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CorrectDetails" name="Correct product details">
      <bpmn:incoming>P8</bpmn:incoming>
      <bpmn:outgoing>P9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendCorrections" name="Send corrected details">
      <bpmn:incoming>P9</bpmn:incoming>
      <bpmn:outgoing>P10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Producer" targetRef="Task_SubmitDetails" />
    <bpmn:sequenceFlow id="P2" sourceRef="Task_SubmitDetails" targetRef="Task_SendSubmission" />
    <bpmn:sequenceFlow id="P3" sourceRef="Task_SendSubmission" targetRef="Gateway_ProducerMerge" />
    <bpmn:sequenceFlow id="P4" sourceRef="Gateway_ProducerMerge" targetRef="Gateway_WaitOutcome" />
    <bpmn:sequenceFlow id="P5" sourceRef="Gateway_WaitOutcome" targetRef="Catch_Published" />
    <bpmn:sequenceFlow id="P6" sourceRef="Catch_Published" targetRef="End_ProducerPublished" />
    <bpmn:sequenceFlow id="P7" sourceRef="Gateway_WaitOutcome" targetRef="Catch_Correction" />
    <bpmn:sequenceFlow id="P8" sourceRef="Catch_Correction" targetRef="Task_CorrectDetails" />
    <bpmn:sequenceFlow id="P9" sourceRef="Task_CorrectDetails" targetRef="Task_SendCorrections" />
    <bpmn:sequenceFlow id="P10" sourceRef="Task_SendCorrections" targetRef="Gateway_ProducerMerge" />
  </bpmn:process>
  <bpmn:process id="Process_ProductValidation" name="Use Case 1 - Product validation and certification" isExecutable="true">
    <bpmn:documentation>Ahmed Cards 21 and 22. Registered producer submits required product fields. Validate required fields and their types, including Boolean organicClaimed. If invalid, return clear feedback and wait for corrected data. Check certification only when claimed. The certification service task completes only after successful verification. Invalid certification and unavailable verification must not complete the task or permit publication. Taha Card 23 supplies the detailed external call, result and exception paths. Default Zeebe job retries are three; an exhausted failed job raises an incident as taught in Week 8. Workers and deployment are pending. Inventory updates are a separate operational process. No administrator review, cancellation option or new retry schedule is introduced here.</bpmn:documentation>
    <bpmn:startEvent id="Start_ProductSubmitted" name="Product submitted">
      <bpmn:messageEventDefinition messageRef="Msg_Submitted" />
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ValidationMerge" name="">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ValidateDetails" name="Validate product details">
      <bpmn:documentation>Validate product name, description, category, price, quantity, availability period and farm origin. Handle harvest, allergens, organic certificate and best-before information where relevant. Return validationPassed as a Boolean and clear validationErrors. Check that organicClaimed is Boolean before reporting validation success. Exact field limits must come from agreed requirements.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-product-details" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DetailsValid" name="Details valid?" default="F_Invalid">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_OrganicClaim" name="Organic claimed?" default="F_NotOrganic">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:outgoing>F_Organic</bpmn:outgoing>
      <bpmn:outgoing>F_NotOrganic</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyCertification" name="Check organic certification">
      <bpmn:documentation>External or simulated certificate check required by Use Case 1. Complete this job only when a claimed certificate has been successfully verified. An invalid or unavailable result cannot proceed to publication. Detailed result handling, external interaction and exceptions belong to Taha Card 23.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-organic-cert" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Organic</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PublicationJoin" name="">
      <bpmn:incoming>F_NotOrganic</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PublishProduct" name="Publish validated product">
      <bpmn:documentation>Publish only after successful mandatory validation and successful certification verification where claimed. Exact stock and seasonal rules are shared with the inventory process under Use Case 1.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-product" />
      </bpmn:extensionElements>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyPublished" name="Confirm product publication">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-product-published" />
      </bpmn:extensionElements>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_ProductPublished" name="Product published">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RequestCorrection" name="Request product corrections">
      <bpmn:documentation>Return clear validation feedback identifying missing or invalid information. Producer corrects details and resubmits. The corrected submission goes through validation again.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-product-correction" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Invalid</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_CorrectedDetails" name="Corrected details received">
      <bpmn:messageEventDefinition messageRef="Msg_Corrected" />
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_ProductSubmitted" targetRef="Gateway_ValidationMerge" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gateway_ValidationMerge" targetRef="Task_ValidateDetails" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_ValidateDetails" targetRef="Gateway_DetailsValid" />
    <bpmn:sequenceFlow id="F_Valid" sourceRef="Gateway_DetailsValid" targetRef="Gateway_OrganicClaim" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Invalid" sourceRef="Gateway_DetailsValid" targetRef="Task_RequestCorrection" name="No" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_RequestCorrection" targetRef="Catch_CorrectedDetails" />
    <bpmn:sequenceFlow id="F5" sourceRef="Catch_CorrectedDetails" targetRef="Gateway_ValidationMerge" />
    <bpmn:sequenceFlow id="F_Organic" sourceRef="Gateway_OrganicClaim" targetRef="Task_VerifyCertification" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= organicClaimed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotOrganic" sourceRef="Gateway_OrganicClaim" targetRef="Gateway_PublicationJoin" name="No" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_VerifyCertification" targetRef="Gateway_PublicationJoin" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gateway_PublicationJoin" targetRef="Task_PublishProduct" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_PublishProduct" targetRef="Task_NotifyPublished" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_NotifyPublished" targetRef="End_ProductPublished" />
    <bpmn:textAnnotation id="Note_CertificationHandoff">
      <bpmn:text>Card 23 handoff to Taha
External service interaction and exception paths.
Verification success is required before publication.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Certification" sourceRef="Task_VerifyCertification" targetRef="Note_CertificationHandoff" associationDirection="None" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ProductValidation">
    <bpmndi:BPMNPlane id="Plane_ProductValidation" bpmnElement="Collaboration_ProductValidation">
      <bpmndi:BPMNShape id="Shape_Pool_Producer" bpmnElement="Pool_Producer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1760" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pool_Marketplace" bpmnElement="Pool_Marketplace" isHorizontal="true">
        <dc:Bounds x="0" y="440" width="1760" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Producer" bpmnElement="Start_Producer">
        <dc:Bounds x="90" y="150" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="55" y="193" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitDetails" bpmnElement="Task_SubmitDetails">
        <dc:Bounds x="180" y="128" width="150" height="80" />
