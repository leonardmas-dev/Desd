<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_UC1_Validation" targetNamespace="https://brfn.example/uc1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_Submitted" name="brfn.product.submitted" />
  <bpmn:message id="Msg_Correction" name="brfn.product.correction-requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= submissionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Corrected" name="brfn.product.corrected">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= submissionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Published" name="brfn.product.published">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= submissionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_ProductValidation">
    <bpmn:participant id="Pool_Producer" name="Registered Producer" processRef="Process_ProducerSubmission" />
    <bpmn:participant id="Pool_Marketplace" name="Marketplace System" processRef="Process_ProductValidation" />
    <bpmn:messageFlow id="M_Submit" sourceRef="Task_SendSubmission" targetRef="Start_ProductSubmitted" name="Product submission" />
    <bpmn:messageFlow id="M_Correct" sourceRef="Task_SendCorrections" targetRef="Catch_CorrectedDetails" name="Corrected product data" />
    <bpmn:messageFlow id="M_Feedback" sourceRef="Task_RequestCorrection" targetRef="Catch_Correction" name="Validation feedback" />
    <bpmn:messageFlow id="M_Published" sourceRef="Task_NotifyPublished" targetRef="Catch_Published" name="Publication confirmed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProducerSubmission" name="Producer submission and corrections" isExecutable="false">
    <bpmn:startEvent id="Start_Producer" name="List a product">
      <bpmn:outgoing>P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitDetails" name="Submit product details">
      <bpmn:incoming>P1</bpmn:incoming>
      <bpmn:outgoing>P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendSubmission" name="Send product submission">
      <bpmn:incoming>P2</bpmn:incoming>
      <bpmn:outgoing>P3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_ProducerMerge" name="">
      <bpmn:incoming>P3</bpmn:incoming>
      <bpmn:outgoing>P4</bpmn:outgoing>
      <bpmn:incoming>P10</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_WaitOutcome" name="Wait for response">
      <bpmn:incoming>P4</bpmn:incoming>
      <bpmn:outgoing>P5</bpmn:outgoing>
      <bpmn:outgoing>P7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Published" name="Publication confirmed">
      <bpmn:messageEventDefinition messageRef="Msg_Published" />
      <bpmn:incoming>P5</bpmn:incoming>
      <bpmn:outgoing>P6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_ProducerPublished" name="Product listed">
      <bpmn:incoming>P6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_Correction" name="Correction requested">
      <bpmn:messageEventDefinition messageRef="Msg_Correction" />
      <bpmn:incoming>P7</bpmn:incoming>
      <bpmn:outgoing>P8</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CorrectDetails" name="Correct product details">
      <bpmn:incoming>P8</bpmn:incoming>
      <bpmn:outgoing>P9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendCorrections" name="Send corrected details">
      <bpmn:incoming>P9</bpmn:incoming>
      <bpmn:outgoing>P10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Producer" targetRef="Task_SubmitDetails" />
    <bpmn:sequenceFlow id="P2" sourceRef="Task_SubmitDetails" targetRef="Task_SendSubmission" />
    <bpmn:sequenceFlow id="P3" sourceRef="Task_SendSubmission" targetRef="Gateway_ProducerMerge" />
    <bpmn:sequenceFlow id="P4" sourceRef="Gateway_ProducerMerge" targetRef="Gateway_WaitOutcome" />
    <bpmn:sequenceFlow id="P5" sourceRef="Gateway_WaitOutcome" targetRef="Catch_Published" />
    <bpmn:sequenceFlow id="P6" sourceRef="Catch_Published" targetRef="End_ProducerPublished" />
    <bpmn:sequenceFlow id="P7" sourceRef="Gateway_WaitOutcome" targetRef="Catch_Correction" />
    <bpmn:sequenceFlow id="P8" sourceRef="Catch_Correction" targetRef="Task_CorrectDetails" />
    <bpmn:sequenceFlow id="P9" sourceRef="Task_CorrectDetails" targetRef="Task_SendCorrections" />
    <bpmn:sequenceFlow id="P10" sourceRef="Task_SendCorrections" targetRef="Gateway_ProducerMerge" />
  </bpmn:process>
  <bpmn:process id="Process_ProductValidation" name="Use Case 1 - Product validation and certification" isExecutable="true">
    <bpmn:documentation>Ahmed Cards 29 and 36: Marketplace System is the executable participant; the producer pool is descriptive. Validate product fields and Boolean organicClaimed before routing. A claimed organic certificate must return valid before publication. Invalid certification returns to producer correction. SERVICE_UNAVAILABLE business errors, unavailable results and interrupting certification timeouts enter a bounded retry path. After three failed attempts, a human review is required. An approve decision retries verification; reject requests correction. Review never publishes a claimed organic product without verification. The three-attempt limit follows the existing team functionality document. Timeout and exponential retry base delay are configurable demonstration settings, not Use Case 1 business rules. Thierno Card 33 owns workers/simulated service; Leonard Card 32 owns the manual review form. Taha Card 23 external-call integration must be reconciled with his shared source before replacing that work.</bpmn:documentation>
    <bpmn:startEvent id="Start_ProductSubmitted" name="Product submitted">
      <bpmn:messageEventDefinition messageRef="Msg_Submitted" />
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ValidationMerge" name="">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ValidateDetails" name="Validate product details">
      <bpmn:documentation>Validate product name, description, category, price, quantity, availability period and farm origin. Handle harvest, allergens, organic certificate and best-before information where relevant. Return validationPassed as a Boolean and clear validationErrors. Check that organicClaimed is Boolean before reporting validation success. Exact field limits must come from agreed requirements.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-product-details" />
        <zeebe:ioMapping>
          <zeebe:output source="= validationPassed" target="validationPassed" />
          <zeebe:output source="= validationErrors" target="validationErrors" />
          <zeebe:output source="= organicClaimed" target="organicClaimed" />
          <zeebe:output source="= 0" target="certificationFailures" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DetailsValid" name="Details valid?" default="F_Invalid">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_OrganicClaim" name="Organic claimed?" default="F_NotOrganic">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:outgoing>F_Organic</bpmn:outgoing>
      <bpmn:outgoing>F_NotOrganic</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyCertification" name="Check organic certification">
      <bpmn:documentation>Worker type verify-organic-cert. Complete with certificationResult: valid, invalid or unavailable. Alternatively throw BPMN error SERVICE_UNAVAILABLE for service unavailability. Never report valid without verification. Each attempt is interrupted after certificationTimeout (ISO 8601 duration); PT30S is the demonstration fallback. Technical job failures retain default Zeebe retries and can raise incidents; business unavailability uses the explicit bounded route.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-organic-cert" />
        <zeebe:ioMapping>
          <zeebe:output source="= certificationResult" target="certificationResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:incoming>F_CheckCertification</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PublicationJoin" name="">
      <bpmn:incoming>F_NotOrganic</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:incoming>F_CertValid</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PublishProduct" name="Publish validated product">
      <bpmn:documentation>Publish only after successful mandatory validation and successful certification verification where claimed. Exact stock and seasonal rules are shared with the inventory process under Use Case 1.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-product" />
      </bpmn:extensionElements>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_NotifyPublished" name="Confirm product publication">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-product-published" />
      </bpmn:extensionElements>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_ProductPublished" name="Product published">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RequestCorrection" name="Request product corrections">
      <bpmn:documentation>Return clear validation feedback identifying missing or invalid information. Producer corrects details and resubmits. The corrected submission goes through validation again.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-product-correction" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:incoming>F_RequestCorrection</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_CorrectedDetails" name="Corrected details received">
      <bpmn:messageEventDefinition messageRef="Msg_Corrected" />
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_ProductSubmitted" targetRef="Gateway_ValidationMerge" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gateway_ValidationMerge" targetRef="Task_ValidateDetails" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_ValidateDetails" targetRef="Gateway_DetailsValid" />
    <bpmn:sequenceFlow id="F_Valid" sourceRef="Gateway_DetailsValid" targetRef="Gateway_OrganicClaim" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Invalid" sourceRef="Gateway_DetailsValid" targetRef="Gateway_CorrectionMerge" name="No" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_RequestCorrection" targetRef="Catch_CorrectedDetails" />
    <bpmn:sequenceFlow id="F5" sourceRef="Catch_CorrectedDetails" targetRef="Gateway_ValidationMerge" />
    <bpmn:sequenceFlow id="F_Organic" sourceRef="Gateway_OrganicClaim" targetRef="Gateway_CertificationMerge" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= organicClaimed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotOrganic" sourceRef="Gateway_OrganicClaim" targetRef="Gateway_PublicationJoin" name="No" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_VerifyCertification" targetRef="Gateway_CertificationResult" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gateway_PublicationJoin" targetRef="Task_PublishProduct" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_PublishProduct" targetRef="Task_NotifyPublished" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_NotifyPublished" targetRef="End_ProductPublished" />
    <bpmn:textAnnotation id="Note_CertificationHandoff">
      <bpmn:text>Cards 29 / 36: executable routing, error, timeout and bounded retries.
Card 33: simulated verifier / workers. Card 32: review form.
Card 23: reconcile Taha external-call source before replacement.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Certification" sourceRef="Task_VerifyCertification" targetRef="Note_CertificationHandoff" associationDirection="None" />
    <bpmn:exclusiveGateway id="Gateway_CertificationResult" name="Certification result?" default="F_UnexpectedResult">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F_CertValid</bpmn:outgoing>
      <bpmn:outgoing>F_CertInvalid</bpmn:outgoing>
      <bpmn:outgoing>F_CertUnavailable</bpmn:outgoing>
      <bpmn:outgoing>F_UnexpectedResult</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="Boundary_CertificationUnavailable" name="Service unavailable" attachedToRef="Task_VerifyCertification" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="Error_CertificationUnavailable" />
      <bpmn:outgoing>F_ErrorRetry</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CertificationTimeout" name="Verification timed out" attachedToRef="Task_VerifyCertification" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= if certificationTimeout = null then "PT30S" else certificationTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>F_TimeoutRetry</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_RetryMerge" name="">
      <bpmn:incoming>F_CertUnavailable</bpmn:incoming>
      <bpmn:incoming>F_ErrorRetry</bpmn:incoming>
      <bpmn:incoming>F_TimeoutRetry</bpmn:incoming>
      <bpmn:outgoing>F_WaitRetry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_RetryDelay" name="Wait before retry">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= certificationFailures + 1" target="certificationFailures" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= "PT" + string((if certificationRetrySeconds = null then 1 else certificationRetrySeconds) * 2 ** certificationFailures) + "S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>F_WaitRetry</bpmn:incoming>
      <bpmn:outgoing>F_CheckRetries</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_RetriesRemaining" name="Attempts remaining?" default="F_RetriesExhausted">
      <bpmn:incoming>F_CheckRetries</bpmn:incoming>
      <bpmn:outgoing>F_RetryCertification</bpmn:outgoing>
      <bpmn:outgoing>F_RetriesExhausted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CertificationMerge" name="">
      <bpmn:incoming>F_Organic</bpmn:incoming>
      <bpmn:outgoing>F_CheckCertification</bpmn:outgoing>
      <bpmn:incoming>F_RetryCertification</bpmn:incoming>
      <bpmn:incoming>F_ReviewRetry</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="">
      <bpmn:incoming>F_UnexpectedResult</bpmn:incoming>
      <bpmn:incoming>F_RetriesExhausted</bpmn:incoming>
      <bpmn:outgoing>F_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewCertification" name="Review unresolved verification">
      <bpmn:documentation>Leonard Card 32 supplies the manual review form. Return Boolean reviewApproved. True authorizes a fresh verification attempt; false requests producer correction. This decision does not satisfy the certification check or permit publication by itself. Candidate group is a runtime assignment, independent of pool/lanes, per Week 9.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= reviewApproved" target="reviewApproved" />
          <zeebe:output source="= 0" target="certificationFailures" />
        </zeebe:ioMapping>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="marketplace-reviewers" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Review</bpmn:incoming>
      <bpmn:outgoing>F_ReviewDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewApproved" name="Retry approved?" default="F_ReviewCorrection">
      <bpmn:incoming>F_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>F_ReviewRetry</bpmn:outgoing>
      <bpmn:outgoing>F_ReviewCorrection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CorrectionMerge" name="">
      <bpmn:incoming>F_Invalid</bpmn:incoming>
      <bpmn:incoming>F_CertInvalid</bpmn:incoming>
      <bpmn:incoming>F_ReviewCorrection</bpmn:incoming>
      <bpmn:outgoing>F_RequestCorrection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_CheckCertification" sourceRef="Gateway_CertificationMerge" targetRef="Task_VerifyCertification" />
    <bpmn:sequenceFlow id="F_CertValid" sourceRef="Gateway_CertificationResult" targetRef="Gateway_PublicationJoin" name="Valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= certificationResult = "valid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CertInvalid" sourceRef="Gateway_CertificationResult" targetRef="Gateway_CorrectionMerge" name="Invalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= certificationResult = "invalid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CertUnavailable" sourceRef="Gateway_CertificationResult" targetRef="Gateway_RetryMerge" name="Unavailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= certificationResult = "unavailable"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_UnexpectedResult" sourceRef="Gateway_CertificationResult" targetRef="Gateway_ReviewMerge" name="Unexpected result" />
    <bpmn:sequenceFlow id="F_ErrorRetry" sourceRef="Boundary_CertificationUnavailable" targetRef="Gateway_RetryMerge" />
    <bpmn:sequenceFlow id="F_TimeoutRetry" sourceRef="Boundary_CertificationTimeout" targetRef="Gateway_RetryMerge" />
    <bpmn:sequenceFlow id="F_WaitRetry" sourceRef="Gateway_RetryMerge" targetRef="Catch_RetryDelay" />
    <bpmn:sequenceFlow id="F_CheckRetries" sourceRef="Catch_RetryDelay" targetRef="Gateway_RetriesRemaining" />
    <bpmn:sequenceFlow id="F_RetryCertification" sourceRef="Gateway_RetriesRemaining" targetRef="Gateway_CertificationMerge" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= certificationFailures &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_RetriesExhausted" sourceRef="Gateway_RetriesRemaining" targetRef="Gateway_ReviewMerge" name="No" />
    <bpmn:sequenceFlow id="F_Review" sourceRef="Gateway_ReviewMerge" targetRef="Task_ReviewCertification" />
    <bpmn:sequenceFlow id="F_ReviewDecision" sourceRef="Task_ReviewCertification" targetRef="Gateway_ReviewApproved" />
    <bpmn:sequenceFlow id="F_ReviewRetry" sourceRef="Gateway_ReviewApproved" targetRef="Gateway_CertificationMerge" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ReviewCorrection" sourceRef="Gateway_ReviewApproved" targetRef="Gateway_CorrectionMerge" name="No" />
    <bpmn:sequenceFlow id="F_RequestCorrection" sourceRef="Gateway_CorrectionMerge" targetRef="Task_RequestCorrection" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ProductValidation">
    <bpmndi:BPMNPlane id="Plane_ProductValidation" bpmnElement="Collaboration_ProductValidation">
      <bpmndi:BPMNShape id="Shape_Pool_Producer" bpmnElement="Pool_Producer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2360" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pool_Marketplace" bpmnElement="Pool_Marketplace" isHorizontal="true">
        <dc:Bounds x="0" y="440" width="2360" height="1000" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Producer" bpmnElement="Start_Producer">
        <dc:Bounds x="90" y="150" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="55" y="193" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitDetails" bpmnElement="Task_SubmitDetails">
        <dc:Bounds x="180" y="128" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendSubmission" bpmnElement="Task_SendSubmission">
        <dc:Bounds x="390" y="128" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ProducerMerge" bpmnElement="Gateway_ProducerMerge">
        <dc:Bounds x="600" y="143" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_WaitOutcome" bpmnElement="Gateway_WaitOutcome">
        <dc:Bounds x="700" y="143" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="195" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_Published" bpmnElement="Catch_Published">
        <dc:Bounds x="940" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="905" y="133" width="115" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ProducerPublished" bpmnElement="End_ProducerPublished">
        <dc:Bounds x="1160" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="130" width="110" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Catch_Correction" bpmnElement="Catch_Correction">
        <dc:Bounds x="810" y="245" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="775" y="288" width="115" height="35" />
