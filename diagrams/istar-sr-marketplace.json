    "name": "Use Case 1 Marketplace SR goals and tasks",
    "customProperties": {
      "Scope": "Use Case 1: Producer Product Listing and Inventory Management.",
      "Purpose": "Show how marketplace tasks contribute to product quality, customer trust and reliable publication decisions.",
